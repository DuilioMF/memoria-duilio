    {
      "id": "plan_safe_title_repairs",
      "name": "Plan safe title repairs",
      "type": "n8n-nodes-base.code",
      "position": [
        1460,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst registry=$(\"Registry for cards\").first().json;\nconst manifest=registry.projects?registry:registry.body||registry;\nif(!Array.isArray(manifest.projects))throw new Error(\"MANIFEST_INVALID\");\nconst labels=$(\"Board labels for cards\").all().map(x=>x.json);\nconst ids=new Map(labels.map(l=>[String(l.name||\"\").toLowerCase(),l.id]));\nconst rows=$input.all().flatMap(x=>Array.isArray(x.json)?x.json:[x.json]);\nconst clean=s=>String(s||\"\").normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g,\"\").toLowerCase().trim();\nconst starts=(t,p)=>{t=clean(t);p=clean(p);return !!p&&(t===p||t.startsWith(p+\" \")||t.startsWith(p+\" —\")||t.startsWith(p+\":\"));};\nconst out=[];\nfor(const c of rows){\n if(!c?.id||!c.name||c.closed||starts(c.name,\"Supervisión / Reloj Feli\"))continue;\n const already=manifest.projects.filter(p=>starts(c.name,p.title_prefix));\n if(already.length)continue;\n const byLabel=manifest.projects.filter(p=>{\n   const id=ids.get(String(p.label_name||\"\").toLowerCase());\n   return id&&(c.idLabels||[]).includes(id);\n });\n const children=byLabel.filter(p=>p.inherited_from);\n const selected=children.length===1?children:byLabel.length===1?byLabel:[];\n if(selected.length!==1)continue;\n const p=selected[0];\n if(!p.title_prefix)continue;\n const title=p.title_prefix+\" — \"+String(c.name).trim();\n if(title.length>512)continue;\n out.push({json:{card_id:c.id,title,original:c.name,project_key:p.project_key}});\n}\nreturn out;\n"
      },
      "typeVersion": 2
    },
