    {
      "id": "plan_missing_labels",
      "name": "Plan missing labels",
      "type": "n8n-nodes-base.code",
      "position": [
        980,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst registry=$(\"Registry for colors\").first().json;\nconst manifest=registry.projects?registry:registry.body||registry;\nif(!Array.isArray(manifest.projects))throw new Error(\"MANIFEST_INVALID\");\nconst labels=$input.all().map(x=>x.json);\nconst existing=new Set(labels.map(x=>String(x.name||\"\").trim().toLowerCase()));\nconst emitted=new Set();\nconst result=[];\nfor(const p of manifest.projects){\n  const label=String(p.label_name||\"\").trim();\n  if(!label || !p.label_color)continue;\n  const key=label.toLowerCase();\n  if(existing.has(key)||emitted.has(key))continue;\n  emitted.add(key);\n  result.push({json:{project_key:p.project_key,label_name:label,label_color:p.label_color}});\n}\nreturn result;\n"
      },
      "typeVersion": 2
    },
