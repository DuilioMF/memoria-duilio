    {
      "id": "plan_label_assignments",
      "name": "Plan label assignments",
      "type": "n8n-nodes-base.code",
      "position": [
        1460,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst registry=$(\"Registry for cards\").first().json;\nconst manifest=registry.projects?registry:registry.body||registry;\nif(!Array.isArray(manifest.projects))throw new Error(\"MANIFEST_INVALID\");\nconst labels=$(\"Board labels for cards\").all().map(x=>x.json);\nconst ids=new Map(labels.map(x=>[String(x.name||\"\").trim().toLowerCase(),x.id]));\nconst rows=$input.all().flatMap(x=>Array.isArray(x.json)?x.json:[x.json]);\nconst clean=s=>String(s||\"\").normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g,\"\").toLowerCase().trim();\nconst starts=(title,prefix)=>{const t=clean(title),p=clean(prefix);return !!p && (t===p||t.startsWith(p+\" \")||t.startsWith(p+\" —\")||t.startsWith(p+\":\"));};\nconst out=[];\nfor(const c of rows){\n if(!c?.id||!c.name||c.closed)continue;\n let targets=[];\n if(starts(c.name,\"Supervisión / Reloj Feli\")){\n    targets=manifest.projects.filter(p=>[\"supervision\",\"feli-salud\"].includes(p.project_key));\n }else{\n    const matches=manifest.projects.filter(p=>starts(c.name,p.title_prefix));\n    matches.sort((a,b)=>String(b.title_prefix).length-String(a.title_prefix).length);\n    if(matches.length)targets=[matches[0]];\n    else{\n      const byLabel=manifest.projects.filter(p=>{\n        const id=ids.get(String(p.label_name||\"\").toLowerCase());\n        return id && (c.idLabels||[]).includes(id);\n      });\n      const children=byLabel.filter(p=>p.inherited_from);\n      if(children.length===1)targets=children;\n      else if(byLabel.length===1)targets=byLabel;\n    }\n }\n for(const p of targets){\n  const id=ids.get(String(p.label_name||\"\").toLowerCase());\n  if(id && !(c.idLabels||[]).includes(id)){\n    out.push({json:{card_id:c.id,label_id:id,project_key:p.project_key}});\n  }\n }\n}\nreturn out;\n"
      },
      "typeVersion": 2
    },
