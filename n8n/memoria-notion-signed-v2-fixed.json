      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Capture Notion's exact signed bytes even in n8n filesystem binary-data mode.\n// No token is stored, logged or forwarded by this production workflow.\nconst result=[];\nconst input=$input.all();\nfor(let i=0;i<input.length;i++){\n  const p=input[i].json??{};\n  if(!input[i].binary?.data)throw new Error('RAW_BINARY_REQUIRED');\n  const bytes=await this.helpers.getBinaryDataBuffer(i,'data');\n  if(!bytes?.length||bytes.length>60000)throw new Error('RAW_BODY_SIZE_INVALID');\n  const raw=bytes.toString('utf8');\n  if(Buffer.byteLength(raw,'utf8')!==bytes.length)throw new Error('INVALID_UTF8');\n  let parsed;\n  try{parsed=JSON.parse(raw);}catch{throw new Error('INVALID_JSON');}\n  if(parsed&&typeof parsed==='object'&&typeof parsed.verification_token==='string'){\n    // We ACK the subscription handshake, but do NOT expose or persist its private token.\n    result.push({json:{is_handshake:true,handshake_received:true}});\n    continue;\n  }\n  const headers=p.headers??{};\n  const signature=headers['x-notion-signature']??headers['X-Notion-Signature'];\n  if(typeof signature!=='string'||!/^sha256=[a-f0-9]{64}$/i.test(signature))throw new Error('NOTION_SIGNATURE_REQUIRED');\n  result.push({json:{is_handshake:false,raw_body:raw,signature}});\n}\nreturn result;"
      }
