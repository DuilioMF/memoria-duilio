    {
      "parameters": {
        "functionCode": "const msg = (\n  $json.body?.mensaje_audio ||\n  $json.body?.mensaje ||\n  $json.mensaje ||\n  \"\"\n).trim();\n\n// limpiar saludo\nconst limpio = msg\n  .replace(/^\\s*(hola|buen dia|buen día|buenas|buenas tardes|buenas noches)[\\s,!.\\-]*/i, '')\n  .trim();\n\nreturn [{\n  json: {\n    ...$json,\n    mensaje_original: msg,\n    mensaje_limpio: limpio\n  }\n}];"
      },
